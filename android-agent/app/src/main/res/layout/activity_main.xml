<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👑 Safa OS Engine"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FF6B00"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="دۆخ: خزمەتگوزاری ناچالاکە"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnEnable"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="چالاککردن لە Accessibility"
        android:textSize="16sp"
        android:backgroundTint="#FF6B00"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📡 بەستراوەتەوە بە AlwaysData Cloud 24/7"
        android:textSize="14sp"
        android:textColor="#888888" />

</LinearLayout>
